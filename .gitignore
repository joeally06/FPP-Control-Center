# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database files
*.db
votes.db
*.db-shm
*.db-wal
*.db-journal
votes.db.corrupt-*
votes.db.dump
*.db.backup*

# backups
backups/
!backups/.gitkeep

# test files
test.js
test-sync.ts

# update logs and signals
logs/
logs/*.log
logs/*.pid
.update-requested
.restart-signal

# audio files (large media files - downloaded from FPP)
public/audio/*.mp3
public/audio/*.wav
public/audio/*.ogg
public/audio/*.m4a
public/audio/*.flac
public/audio/*.aac

# audio mapping (keep this in git for configuration)
# data/audio-mapping.json is tracked